# --- שרת ---
PORT=3000
NODE_ENV=production
TRUST_PROXY=1
PUBLIC_URL=https://your-domain.example

# --- מנוי Pro (Stripe) ---
# יוצרים ב-Stripe: מוצר + מחיר חודשי (Price), ומפעילים את Customer Portal בהגדרות.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PRICE_ID=price_xxx
# סוד אקראי ארוך לחתימת עוגיית המנוי, למשל: openssl rand -hex 32
PRO_TOKEN_SECRET=
PRICE_LABEL=19.90 ₪ לחודש

# פיתוח מקומי בלבד (נחסם ב-production): פותח Pro בלי תשלום
# PRO_DEV_UNLOCK=1

# --- בוט וואטסאפ (Meta WhatsApp Cloud API) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=            # אסימון קבוע (System User) עם הרשאת whatsapp_business_messaging
WA_BUSINESS_NUMBER=972500000000   # המספר העסקי בספרות בלבד, לקישור wa.me
WA_APP_SECRET=              # App Secret של אפליקציית Meta, לאימות חתימת ה-webhook
WA_VERIFY_TOKEN=            # מחרוזת אקראית שבוחרים; אותה מזינים בהגדרת ה-webhook ב-Meta
WA_DATA_KEY=                # 64 תווי hex להצפנת הנתונים: openssl rand -hex 32
WA_DB_PATH=/data/whatsapp.db
WA_REMINDER_TEMPLATE=       # שם תבנית תזכורת מאושרת (אופציונלי)
# פיתוח מקומי: WA_DEV=1 מפעיל נתיב סימולציה להודעה נכנסת
