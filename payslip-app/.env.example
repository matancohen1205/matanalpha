# --- שרת ---
PORT=3000
NODE_ENV=production
TRUST_PROXY=1
PUBLIC_URL=https://your-domain.example

# --- מנוי Pro (Stripe) ---
# יוצרים ב-Stripe: מוצר + מחיר חודשי (Price), ומפעילים את Customer Portal בהגדרות.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PRICE_ID=price_xxx
# סוד אקראי ארוך לחתימת עוגיית המנוי, למשל: openssl rand -hex 32
PRO_TOKEN_SECRET=
PRICE_LABEL=19.90 ₪ לחודש

# פיתוח מקומי בלבד (נחסם ב-production): פותח Pro בלי תשלום
# PRO_DEV_UNLOCK=1

# --- בוט וואטסאפ (Meta WhatsApp Cloud API) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=            # אסימון קבוע (System User) עם הרשאת whatsapp_business_messaging
WA_BUSINESS_NUMBER=972500000000   # המספר העסקי בספרות בלבד, לקישור wa.me
WA_APP_SECRET=              # App Secret של אפליקציית Meta, לאימות חתימת ה-webhook
WA_VERIFY_TOKEN=            # מחרוזת אקראית שבוחרים; אותה מזינים בהגדרת ה-webhook ב-Meta
WA_DATA_KEY=                # 64 תווי hex להצפנת הנתונים: openssl rand -hex 32
WA_DB_PATH=/data/whatsapp.db
WA_REMINDER_TEMPLATE=       # שם תבנית תזכורת מאושרת (אופציונלי)
# פיתוח מקומי: WA_DEV=1 מפעיל נתיב סימולציה להודעה נכנסת

# --- שירות לקוחות (טופס צור קשר ועוזר האתר) ---
DB_PATH=/data/app.db               # מסד SQLite משותף לפניות ולוואטסאפ (כרך קבוע). ניתן להשאיר WA_DB_PATH לתאימות
DATA_KEY=                           # 64 תווי hex להצפנת פניות ונתוני וואטסאפ (openssl rand -hex 32)
SUPPORT_EMAIL=support@your-domain.example   # מוצג באתר וכתובת ברירת מחדל לקבלת פניות
SUPPORT_WHATSAPP=972500000000       # אופציונלי: מספר וואטסאפ שירות לקוחות להצגה באתר
SUPPORT_HOURS=א׳-ה׳ 9:00-17:00       # אופציונלי
SMTP_URL=                           # נדרש לשחזור מנוי, אימות כתובת ואיפוס סיסמה, ולפניות במייל: smtps://user:pass@smtp.example.com:465
MAIL_FROM=Tlush <no-reply@your-domain.example>
SUPPORT_NOTIFY_TO=                  # אופציונלי: נמען שונה מ-SUPPORT_EMAIL

# --- אבטחה ---
SECURITY_CONTACT=security@your-domain.example   # מוצג ב-/.well-known/security.txt (ברירת מחדל: SUPPORT_EMAIL)
# RATE_LIMIT_HEAVY=20      # בקשות כבדות (סריקה/תשלום) ל-IP ב-10 דקות

# מנוי שנתי (אופציונלי)
STRIPE_PRICE_ID_YEARLY=
PRICE_LABEL_YEARLY=
PRICE_AMOUNT_YEARLY_AGOROT=

# עוזר האתר מבוסס בינה מלאכותית (Claude). בלי מפתח פועל עוזר מבוסס כללים בדפדפן
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-haiku-4-5-20251001
# AGENT_DAILY_LIMIT=2000      # תקרת הודעות ביום לכל האתר (הגבלת עלות)
# AGENT_RATE_LIMIT=25         # הודעות ל-10 דקות לכל כתובת IP


# ממשק ניהול פניות ב-/admin.html (בעל האתר בלבד). 12 תווים ומעלה; בלי ערך הממשק כבוי
ADMIN_PASSWORD=
